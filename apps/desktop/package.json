{
    "name": "desktop",
    "version": "2.0.1",
    "private": true,
    "description": "Video Helper Desktop Application",
    "repository": {
        "type": "git",
        "url": "https://github.com/LDJ-creat/video-helper.git"
    },
    "main": "dist/main.js",
    "scripts": {
        "dev": "concurrently \"pnpm compile:watch\" \"electron .\"",
        "compile": "tsc -p tsconfig.json",
        "compile:watch": "tsc -p tsconfig.json --watch",
        "build-icons": "electron-icon-builder --input=./resources/icon.png --output=./resources --flatten",
        "fix-icons": "uv run --directory ../../services/core python ../../scripts/desktop/fix_icon_checkerboard.py --sync-ico",
        "remove-icon-black-bg": "uv run --directory ../../services/core python ../../scripts/desktop/remove_black_background.py --sync-icons",
        "build": "pnpm compile && electron-builder",
        "pack": "pnpm compile && electron-builder --dir"
    },
    "dependencies": {
        "electron-is-dev": "^3.0.0",
        "electron-updater": "^6.8.3"
    },
    "devDependencies": {
        "@types/node": "^20",
        "concurrently": "^8.2.0",
        "electron": "^41.0.2",
        "electron-builder": "^25.0.0",
        "electron-icon-builder": "^2.0.1",
        "typescript": "^5.3.0"
    },
    "build": {
        "beforePack": "scripts/beforePack.cjs",
        "appId": "com.videohelper.desktop",
        "publish": [
            {
                "provider": "github",
                "owner": "LDJ-creat",
                "repo": "video-helper"
            }
        ],
        "productName": "Video Helper",
        "copyright": "Copyright © 2025 Video Helper",
        "directories": {
            "output": "release",
            "buildResources": "resources"
        },
        "files": [
            "dist/**/*"
        ],
        "extraResources": [
            {
                "from": "resources/backend",
                "to": "backend",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "resources/icons",
                "to": "icons",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../web/.next/standalone/apps/web",
                "to": "web/apps/web",
                "filter": [
                    "**/*",
                    "!**/.next",
                    "!**/.next/**"
                ]
            },
            {
                "from": "../web/.next/standalone/apps/web/.next",
                "to": "web/apps/web/.next",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../web/.next/static",
                "to": "web/apps/web/.next/static",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../web/public",
                "to": "web/apps/web/public",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "artifactName": "Video-Helper-Setup-${version}.${ext}",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "resources/icons/icon.ico"
        },
        "mac": {
            "artifactName": "Video-Helper-${version}-mac-${arch}.${ext}",
            "icon": "resources/icons/icon.icns",
            "target": [
                "dmg",
                "zip"
            ]
        },
        "linux": {
            "artifactName": "Video-Helper-${version}-linux-${arch}.${ext}",
            "icon": "resources/icons/1024x1024.png",
            "target": [
                "AppImage",
                "tar.gz"
            ],
            "category": "Utility"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Video Helper"
        }
    }
}